#!/bin/bash -e

cp envs/example.env envs/.env

# Build app image explicitly so services that reference it don't try to pull it
DOCKER_BUILDKIT=0 docker compose build django

# Lint checks (fails fast if code is not clean)
s/lint --check

# Only services needed for tests (avoids running flower/mkdocs/etc)
DOCKER_BUILDKIT=0 docker compose up -d postgis redis

# Regenerate static files manifest in the mounted volume (volume overrides the
# baked-in staticfiles from the Docker build, so manifest can be stale)
docker compose run --rm django python manage.py collectstatic --no-input

# Run all tests except csv upload (fresh container, memory freed on exit)
# --create-db forces a fresh test DB so session-scoped fixtures re-run correctly
docker compose run --rm django pytest -v --create-db --ignore=project/npda/tests/test_csv_upload.py

# Run csv upload tests separately so each batch starts with a clean process
docker compose run --rm django pytest -v --create-db project/npda/tests/test_csv_upload.py

# Check the build for the MkDocs static site
docker compose run --rm mkdocs mkdocs build --config-file documentation/mkdocs.yml

docker compose down -v

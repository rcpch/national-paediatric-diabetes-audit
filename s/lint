#!/bin/bash -e

# lint - runs black, isort, and ruff on the codebase
#
# Usage:
#   s/lint           fix mode: applies formatting and auto-fixes in place
#   s/lint --check   check mode: exits non-zero if anything is not clean (used in CI)

CHECK_FLAG=""
ISORT_FLAG=""
RUFF_FLAG=""

if [[ "$1" == "--check" ]]; then
    CHECK_FLAG="--check"
    ISORT_FLAG="--check-only"
    RUFF_FLAG=""  # ruff check is always check-only unless --fix is passed
fi

echo "▶ black"
black ${CHECK_FLAG} .

echo "▶ isort"
isort ${ISORT_FLAG} .

echo "▶ ruff"
if [[ "$1" == "--check" ]]; then
    ruff check .
else
    ruff check --fix .
fi

echo "✅ lint complete"
